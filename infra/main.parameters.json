{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "preserveLegacyResourceNames": {
      "value": "${AUSPEX_PRESERVE_LEGACY_RESOURCE_NAMES=false}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "openAiLocation": {
      "value": "${AZURE_OPENAI_LOCATION}"
    },
    "authTenantId": {
      "value": "${AUSPEX_AUTH_TENANT_ID}"
    },
    "authClientId": {
      "value": "${AUSPEX_AUTH_CLIENT_ID}"
    },
    "authTenantType": {
      "value": "${AUSPEX_AUTH_TENANT_TYPE=workforce}"
    },
    "authTenantSubdomain": {
      "value": "${AUSPEX_AUTH_TENANT_SUBDOMAIN=}"
    },
    "authAuthorityOverride": {
      "value": "${AUSPEX_AUTH_AUTHORITY=}"
    },
    "authIssuerOverride": {
      "value": "${AUSPEX_AUTH_ISSUER=}"
    },
    "authJwksUrlOverride": {
      "value": "${AUSPEX_AUTH_JWKS_URL=}"
    },
    "authOpenIdConfigurationUrlOverride": {
      "value": "${AUSPEX_AUTH_OPENID_CONFIGURATION_URL=}"
    },
    "authApiScope": {
      "value": "${AUSPEX_AUTH_API_SCOPE=}"
    },
    "authLegacyIssuer": {
      "value": "${AUSPEX_AUTH_LEGACY_ISSUER=}"
    },
    "authLegacyJwksUrl": {
      "value": "${AUSPEX_AUTH_LEGACY_JWKS_URL=}"
    },
    "authLegacyAudience": {
      "value": "${AUSPEX_AUTH_LEGACY_AUDIENCE=}"
    },
    "ownerProviderUserId": {
      "value": "${AUSPEX_OWNER_OBJECT_ID=}"
    },
    "ownerLegacyProviderUserId": {
      "value": "${AUSPEX_OWNER_LEGACY_OBJECT_ID=}"
    },
    "ownerLedgerPartitionKey": {
      "value": "${AUSPEX_OWNER_LEDGER_PARTITION_KEY=}"
    },
    "initialAdminEmail": {
      "value": "${AUSPEX_INITIAL_ADMIN_EMAIL}"
    },
    "secEdgarUserAgent": {
      "value": "${AUSPEX_EDGAR_USER_AGENT}"
    },
    "alertEmailAddress": {
      "value": "${AUSPEX_ALERT_EMAIL}"
    },
    "priceApiKey": {
      "value": "${AUSPEX_PRICE_API_KEY}"
    },
    "newsApiKey": {
      "value": "${AUSPEX_NEWS_API_KEY}"
    },
    "existingKeyVaultName": {
      "value": "${AUSPEX_EXISTING_KEY_VAULT_NAME}"
    },
    "existingKeyVaultResourceGroup": {
      "value": "${AUSPEX_EXISTING_KEY_VAULT_RESOURCE_GROUP}"
    },
    "existingLedgerAccountName": {
      "value": "${AUSPEX_EXISTING_LEDGER_ACCOUNT_NAME}"
    },
    "existingLedgerResourceGroup": {
      "value": "${AUSPEX_EXISTING_LEDGER_RESOURCE_GROUP}"
    },
    "ledgerDatabaseName": {
      "value": "${AUSPEX_LEDGER_DATABASE_NAME}"
    },
    "primaryCosmosAccountNameOverride": {
      "value": "${AUSPEX_PRIMARY_COSMOS_ACCOUNT_NAME=}"
    },
    "storageAccountNameOverride": {
      "value": "${AUSPEX_STORAGE_ACCOUNT_NAME=}"
    },
    "registryNameOverride": {
      "value": "${AUSPEX_REGISTRY_NAME=}"
    },
    "openAiAccountNameOverride": {
      "value": "${AUSPEX_OPENAI_ACCOUNT_NAME=}"
    },
    "monthlyBudgetAmount": {
      "value": "${AUSPEX_MONTHLY_BUDGET}"
    },
    "extractionModelCapacity": {
      "value": "${AUSPEX_EXTRACTION_MODEL_CAPACITY}"
    },
    "narrativeModelCapacity": {
      "value": "${AUSPEX_NARRATIVE_MODEL_CAPACITY}"
    }
  }
}
